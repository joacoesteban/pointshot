{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pointshot",
  "version": "0.1.0",
  "identifier": "io.joaco.pointshot",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "dist",
    "beforeDevCommand": "bunx vite --config desktop/vite.config.ts",
    "beforeBuildCommand": "bunx vite build --config desktop/vite.config.ts"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pointshot",
        "url": "index.html",
        "width": 720,
        "height": 480,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
