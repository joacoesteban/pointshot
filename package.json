{
  "name": "snag",
  "version": "2.0.2",
  "description": "Screenshot any element on the page. Pick it with the mouse, get it in your clipboard.",
  "author": "dev@joacoesteban.com",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:ff": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "bundle": "wxt zip",
    "bundle:firefox": "wxt zip -b firefox",
    "bundle:all": "bun run bundle && bun run bundle:firefox",
    "test:unit": "vitest run",
    "typecheck": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "build:e2e": "wxt build --mode e2e",
    "test": "bun run build:e2e && playwright test",
    "check": "bun run typecheck && bun run lint",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@extend-chrome/messages": "^1.2.2",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "color-hash": "^2.0.2",
    "dexie": "^4.4.7",
    "neverthrow": "^8.2.0",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "svelte-french-toast": "^1.2.0",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/chroma-js": "^3.1.3",
    "@types/chrome": "^0.3.7",
    "@types/color-hash": "^2.0.0",
    "@types/node": "^26.6.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "autoprefixer": "^10.6.2",
    "daisyui": "^4.12.24",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "prettier": "3.0.3",
    "prettier-plugin-svelte": "^3.5.2",
    "sass": "~1.75.0",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "spawn-sync"
  ],
  "packageManager": "bun@1.4.2"
}
